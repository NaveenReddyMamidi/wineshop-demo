# Copy to .env and fill values (DO NOT commit .env)
# Example values for docker-compose environment
SECRET_KEY=my_wine_shop_secret_key
FLASK_ENV=production
POSTGRES_USER=appuser
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=wineshopdb
DATABASE_URL=postgresql+pg8000://appuser:strongpassword@db:5432/wineshopdb
